{
  "name": "notes-api",
  "version": "1.0.0",
  "description": "NoteVault: a REST API with JWT authentication and a notes app (Node.js, Express, SQLite)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning server.js",
